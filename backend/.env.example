# ── API-Football (obavezno) ──
# Kljuc se dobiva na https://dashboard.api-football.com/
FOOTBALL_API_KEY=

# ── Baza ──
# Ostavi prazno za lokalni SQLite (backend/football.db) — nista se ne mora instalirati.
# Za PostgreSQL: postgresql://korisnik:lozinka@localhost:5432/football
DATABASE_URL=

# ── Server ──
PORT=8000
CORS_ORIGINS=http://localhost:3000

# ── Backfill: koje lige i sezone ulaze u skup za treniranje ──
# 39 Premier League, 140 La Liga, 135 Serie A, 78 Bundesliga, 61 Ligue 1,
# 88 Eredivisie, 94 Primeira Liga, 144 Jupiler Pro, 203 Super Lig,
# 2 Liga prvaka, 3 Europska liga
BACKFILL_LEAGUE_IDS=39,140,135,78,61,88,94,144,203,2,3
BACKFILL_SEASONS=2019,2020,2021,2022,2023,2024,2025

# ── Prozori forme ──
FORM_WINDOW_OVERALL=20
FORM_WINDOW_VENUE=10
FORM_WINDOW_RECENT=5

# ── Model ──
ACTIVE_MODEL=logreg
TRAIN_CUTOFF=2025-07-01

# ── Raspored ──
ENABLE_SCHEDULER=true
TIMEZONE=Europe/Zagreb
DAILY_FIXTURES_CRON=5 0
DAILY_RESULTS_CRON=30 2
DAILY_ODDS_CRON=15 3

# ── Admin rute (prazno = onemoguceno) ──
ADMIN_TOKEN=
